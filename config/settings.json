{
  "project": {
    "name": "NetShield Automation",
    "phase": 3,
    "version": "0.2.0",
    "environment": "sandbox"
  },
  "database": {
    "path": "database/netshield.db"
  },
  "logging": {
    "application_log": "logs/application/netshield.log",
    "audit_log": "logs/audit/audit.log"
  },
  "evidence": {
    "directory": "evidence",
    "hash_algorithm": "sha256"
  },
  "security": {
    "default_access": "deny",
    "require_approval_for_disruptive_actions": true,
    "allow_real_external_targets": false
  },
  "pipeline": {
    "raw_directory": "data/raw",
    "processed_directory": "data/processed",
    "accepted_extensions": [
      ".jsonl"
    ],
    "allowed_source_types": [
      "authentication",
      "identity_risk",
      "access_policy",
      "network",
      "wifi",
      "endpoint",
      "application",
      "database",
      "vulnerability",
      "incident",
      "response"
    ],
    "reject_malformed_events": true,
    "preserve_raw_event": true,
    "supported_schema_versions": [
      "1.0",
      "2.0"
    ],
    "default_schema_version": "1.0",
    "quarantine_malformed_events": true,
    "v2_raw_directory": "data/raw/v2"
  },
  "upgrade": {
    "name": "NetShield Enterprise Upgrade",
    "phase": "3A V2",
    "version": "0.1.0",
    "extends": "NetShield Automation"
  },
  "data_protection": {
    "retention_days": {
      "raw_events": 30,
      "processed_events": 90,
      "audit_records": 365,
      "incident_reports": 365
    },
    "sensitive_field_masking": {
      "enabled": true,
      "replacement": "[REDACTED]",
      "fields": [
        "password",
        "access_token",
        "refresh_token",
        "api_key",
        "secret",
        "session_id"
      ]
    }
  }
}
